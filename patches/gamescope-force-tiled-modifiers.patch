diff --git a/src/Backends/WaylandBackend.cpp b/src/Backends/WaylandBackend.cpp
index 964132b..aea9cc3 100644
--- a/src/Backends/WaylandBackend.cpp
+++ b/src/Backends/WaylandBackend.cpp
@@ -2254,7 +2254,26 @@ namespace gamescope
         if ( iter == m_FormatModifiers.end() )
             return std::span<const uint64_t>{};
 
-        return std::span<const uint64_t>{ iter->second.begin(), iter->second.end() };
+        static std::vector<uint64_t> s_vecModifiers;
+        s_vecModifiers.clear();
+        s_vecModifiers.reserve( iter->second.size() );
+
+        xdg_log.infof("GetSupportedModifiers: Filtering modifiers for format 0x%x", uDrmFormat);
+
+        for ( uint64_t ulModifier : iter->second )
+        {
+            // WORKAROUND: Sway/wlroots fail with chosen modifier at 4K.
+            // Exclude it to force using other modifiers.
+            if ( ulModifier == 0x020000000096bb02ULL )
+            {
+                xdg_log.infof("  Skipping modifier 0x%016" PRIx64, ulModifier);
+                continue;
+            }
+            s_vecModifiers.push_back( ulModifier );
+            xdg_log.infof("  Keeping modifier 0x%016" PRIx64, ulModifier);
+        }
+
+        return std::span<const uint64_t>{ s_vecModifiers.begin(), s_vecModifiers.end() };
     }
 
