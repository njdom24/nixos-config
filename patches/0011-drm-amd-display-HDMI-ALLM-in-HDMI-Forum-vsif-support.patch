diff --git a/drivers/gpu/drm/amd/display/modules/inc/mod_info_packet.h b/drivers/gpu/drm/amd/display/modules/inc/mod_info_packet.h
index 91fe039c0c95..ad7cc6a9cd53 100644
--- a/drivers/gpu/drm/amd/display/modules/inc/mod_info_packet.h
+++ b/drivers/gpu/drm/amd/display/modules/inc/mod_info_packet.h
@@ -41,6 +41,9 @@ void mod_build_vsc_infopacket(const struct dc_stream_state *stream,
 void mod_build_hf_vsif_infopacket(const struct dc_stream_state *stream,
 		struct dc_info_packet *info_packet);
 
+void mod_build_forum_vsif_infopacket(const struct drm_display_info *display,
+		struct dc_info_packet *info_packet);
+
 enum adaptive_sync_type {
 	ADAPTIVE_SYNC_TYPE_NONE                  = 0,
 	ADAPTIVE_SYNC_TYPE_DP                    = 1,
diff --git a/drivers/gpu/drm/amd/display/modules/info_packet/info_packet.c b/drivers/gpu/drm/amd/display/modules/info_packet/info_packet.c
index 429bc0ab86d6..e1e9e019f874 100644
--- a/drivers/gpu/drm/amd/display/modules/info_packet/info_packet.c
+++ b/drivers/gpu/drm/amd/display/modules/info_packet/info_packet.c
@@ -47,6 +47,11 @@ enum vsc_packet_revision {
 #define HDMI_INFOFRAME_TYPE_VENDOR 0x81
 #define HF_VSIF_VERSION 1
 
+// HDMI 2.1
+#define HDMI_FORUM_VSIF_VERSION	 1
+#define HDMI_FORUM_VSIF_LENGTH	 27
+#define HDMI_FORUM_VSIF_ALLM_BIT 1
+
 // VTEM Byte Offset
 #define VTEM_PB0		0
 #define VTEM_PB1		1
@@ -441,6 +446,21 @@ void mod_build_vsc_infopacket(const struct dc_stream_state *stream,
 	}
 }
 
+static void set_hdmi_vsif_checksum(struct dc_info_packet *info_packet)
+{
+	uint8_t checksum = 0;
+	uint8_t length = info_packet->hb2 & 0x1F;
+
+	checksum += info_packet->hb0;
+	checksum += info_packet->hb1;
+	checksum += info_packet->hb2;
+
+	for (uint32_t i = 1; i <= length; i++)
+		checksum += info_packet->sb[i];
+
+	info_packet->sb[0] = (uint8_t) (0x100 - checksum);
+}
+
 /**
  *  mod_build_hf_vsif_infopacket - Prepare HDMI Vendor Specific info frame.
  *                                 Follows HDMI Spec to build up Vendor Specific info frame
@@ -453,8 +473,6 @@ void mod_build_hf_vsif_infopacket(const struct dc_stream_state *stream,
 {
 		unsigned int length = 5;
 		bool hdmi_vic_mode = false;
-		uint8_t checksum = 0;
-		uint32_t i = 0;
 		enum dc_timing_3d_format format;
 
 		info_packet->valid = false;
@@ -509,18 +527,40 @@ void mod_build_hf_vsif_infopacket(const struct dc_stream_state *stream,
 		info_packet->hb1 = 0x01;
 		info_packet->hb2 = (uint8_t) (length);
 
-		checksum += info_packet->hb0;
-		checksum += info_packet->hb1;
-		checksum += info_packet->hb2;
-
-		for (i = 1; i <= length; i++)
-			checksum += info_packet->sb[i];
-
-		info_packet->sb[0] = (uint8_t) (0x100 - checksum);
-
+		set_hdmi_vsif_checksum(info_packet);
 		info_packet->valid = true;
 }
 
+/**
+ *  mod_build_forum_vsif_infopacket - Prepare HDMI Forum Vendor Specific info frame.
+ *
+ *  @stream:      contains data we may need to construct VSIF
+ *  @info_packet: output structure where to store VSIF
+ */
+void mod_build_forum_vsif_infopacket(const struct drm_display_info *info,
+		struct dc_info_packet *info_packet)
+{
+	info_packet->valid = false;
+
+	/* Not needed besides ALLM */
+	if (!info->hdmi.allm)
+		return;
+
+	info_packet->hb0 = HDMI_INFOFRAME_TYPE_VENDOR;
+	info_packet->hb1 = 0x01;
+	info_packet->hb2 = HDMI_FORUM_VSIF_LENGTH;
+
+	info_packet->sb[1] = HDMI_FORUM_IEEE_OUI & 0xff;
+	info_packet->sb[2] = (HDMI_FORUM_IEEE_OUI >> 8) & 0xff;
+	info_packet->sb[3] = (HDMI_FORUM_IEEE_OUI >> 16) & 0xff;
+	info_packet->sb[4] = HDMI_FORUM_VSIF_VERSION;
+
+	info_packet->sb[5] = (uint8_t) (info->hdmi.allm << HDMI_FORUM_VSIF_ALLM_BIT);
+
+	set_hdmi_vsif_checksum(info_packet);
+	info_packet->valid = true;
+}
+
 void mod_build_adaptive_sync_infopacket(const struct dc_stream_state *stream,
 		enum adaptive_sync_type asType,
 		const struct AS_Df_params *param,
